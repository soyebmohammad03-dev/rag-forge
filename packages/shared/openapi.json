          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "name",
          "state",
          "detail"
        ],
        "title": "ComponentHealth"
      },
      "ComponentState": {
        "type": "string",
        "enum": [
          "ok",
          "not_configured",
          "error"
        ],
        "title": "ComponentState"
      },
      "ContentOrigin": {
        "type": "string",
        "enum": [
          "retrieved",
          "inferred",
          "generated",
          "measured",
          "simulated"
        ],
        "title": "ContentOrigin",
        "description": "Where a piece of information came from. Every value shown to a user carries one."
      },
      "Corpus": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
