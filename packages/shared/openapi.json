            "title": "Media Type"
          }
        },
        "type": "object",
        "required": [
          "source_uri"
        ],
        "title": "DocumentIngestRequest"
      },
      "EnvironmentResponse": {
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/EnvironmentSnapshot"
          }
