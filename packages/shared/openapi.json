        "title": "ExperimentStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "uptime_seconds": {
            "type": "number",
            "title": "Uptime Seconds"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentHealth"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "started_at",
          "uptime_seconds",
          "components"
        ],
        "title": "HealthStatus"
      },
      "Metric": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "k": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "K"
          },
          "origin": {
            "$ref": "#/components/schemas/ContentOrigin",
            "default": "measured"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "value",
          "k",
          "origin"
        ],
        "title": "Metric"
      },
      "NotImplementedDetail": {
        "properties": {
          "capability": {
            "type": "string",
            "title": "Capability"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "capability",
          "message"
        ],
        "title": "NotImplementedDetail"
      },
      "Query": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "metadata",
          "created_at"
        ],
        "title": "Query"
      },
      "RetrievalEvaluationRequest": {
        "properties": {
          "ranked_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Ranked Ids"
          },
          "relevance": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Relevance",
            "description": "Graded relevance judgements; grade > 0 counts as relevant."
          },
          "ks": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Ks",
            "default": [
              1,
              5,
              10
            ]
          }
        },
        "type": "object",
        "required": [
          "ranked_ids",
          "relevance"
        ],
        "title": "RetrievalEvaluationRequest"
      },
      "RetrievalEvaluationResponse": {
        "properties": {
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/Metric"
            },
            "type": "array",
            "title": "Metrics"
          }
        },
        "type": "object",
        "required": [
          "metrics"
        ],
        "title": "RetrievalEvaluationResponse"
      },
      "RetrievalRequest": {
        "properties": {
          "corpus_id": {
            "type": "string",
            "title": "Corpus Id"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query"
          },
          "strategies": {
            "items": {
              "$ref": "#/components/schemas/RetrievalStrategy"
            },
            "type": "array",
            "minItems": 1,
            "title": "Strategies"
          },
          "top_k": {
            "type": "integer",
            "maximum": 1000.0,
            "exclusiveMinimum": 0.0,
            "title": "Top K",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "corpus_id",
          "query",
          "strategies"
        ],
        "title": "RetrievalRequest"
      },
      "RetrievalResponse": {
        "properties": {
          "query": {
            "$ref": "#/components/schemas/Query"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RetrievalResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "query",
          "results"
        ],
        "title": "RetrievalResponse"
      },
      "RetrievalResult": {
        "properties": {
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "strategy": {
            "$ref": "#/components/schemas/RetrievalStrategy"
          },
          "retriever": {
            "type": "string",
            "title": "Retriever"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "origin": {
            "$ref": "#/components/schemas/ContentOrigin",
            "default": "retrieved"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query_id",
          "strategy",
          "retriever",
          "chunk_id",
          "document_id",
          "rank",
          "score",
          "origin"
        ],
        "title": "RetrievalResult"
      },
      "RetrievalStrategy": {
        "type": "string",
        "enum": [
          "sparse",
          "dense",
          "hybrid",
          "metadata",
          "graph",
          "multi_hop",
          "decomposition",
          "multimodal"
        ],
        "title": "RetrievalStrategy"
      },
      "RouterDecision": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "policy": {
            "type": "string",
            "title": "Policy"
          },
          "query_features": {
            "additionalProperties": true,
            "type": "object",
            "title": "Query Features"
          },
          "selected_strategies": {
            "items": {
              "$ref": "#/components/schemas/RetrievalStrategy"
            },
            "type": "array",
            "title": "Selected Strategies"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "query_id",
          "policy",
          "query_features",
          "selected_strategies",
          "rationale",
          "created_at"
        ],
        "title": "RouterDecision"
      },
      "RouterRequest": {
        "properties": {
          "corpus_id": {
            "type": "string",
            "title": "Corpus Id"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query"
          },
          "policy": {
            "type": "string",
            "title": "Policy"
          }
        },
        "type": "object",
        "required": [
          "corpus_id",
          "query",
          "policy"
        ],
        "title": "RouterRequest"
      },
      "RouterResponse": {
        "properties": {
          "query": {
            "$ref": "#/components/schemas/Query"
          },
          "decision": {
            "$ref": "#/components/schemas/RouterDecision"
          }
        },
        "type": "object",
        "required": [
          "query",
          "decision"
        ],
        "title": "RouterResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
