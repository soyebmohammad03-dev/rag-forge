            "type": "string",
            "title": "Rag Forge Version"
          },
          "python_version": {
            "type": "string",
            "title": "Python Version"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "git_commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Git Commit"
          },
          "packages": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Packages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
